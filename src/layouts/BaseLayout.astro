---
import "../styles/global.css";
import "../styles/redesign.css";
import "../styles/reading-flow.css";
import "../styles/feedback.css";

interface Props {
  title?: string;
  description?: string;
  /** GitHub edit URL of the source this page is generated from. When set,
   *  a floating "Suggest a change" button links to it (opens GitHub's
   *  editor, which forks + proposes a PR for non-collaborators). */
  editUrl?: string;
  /** Site-root-relative path to the social-share (Open Graph) image.
   *  Defaults to the branded 1200×630 card. */
  image?: string;
}

const {
  title = "Apache Magpie — Give maintainers time back",
  description = "AI agent skills for open-source maintainers. Prepare reviews, triage reports, and keep decisions in your hands.",
  image = "/og-image.png",
} = Astro.props;

// Absolute URLs for social-share (Open Graph / Twitter) tags. Scrapers require
// absolute image URLs, so resolve against the configured `site`. The default is
// the 1200×630 branded social card (public/og-image.png); individual pages may
// pass their own `image` (a site-root-relative path) to override it.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}${image}`,
  Astro.site,
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('magpie-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    {/* ICO fallback for clients that don't use the SVG icon (Safari, some
        link/tab unfurlers), which otherwise request /favicon.ico implicitly. */}
    <link rel="icon" type="image/x-icon" sizes="any" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.ico`} />
    {/* Inter, Jost and Geist are self-hosted via Fontsource (src/styles/global.css);
        no external font CDN is loaded (apache/magpie-site#11). */}
    <title>{title}</title>
    {/* Social-share preview (Open Graph + Twitter Card): show the branded Magpie
        card, not the framework default, when links are unfurled on social media. */}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apache Magpie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const sync = () => { const dark = document.documentElement.dataset.theme === 'dark'; button?.setAttribute('aria-pressed', String(dark)); button?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`); const label = button?.querySelector('.theme-label'); if(label) label.textContent = dark ? 'Light' : 'Dark'; };
      button?.addEventListener('click', () => { document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; try { localStorage.setItem('magpie-theme', document.documentElement.dataset.theme); } catch {} sync(); });
      sync();
      const observer = new IntersectionObserver(entries => { entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('animation-started'); observer.unobserve(entry.target); } }); }, { threshold: .4 });
      document.querySelectorAll('.improvement-loop,.project-identity').forEach(el => observer.observe(el));
    </script>


  </body>
</html>
