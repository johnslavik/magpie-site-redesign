---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader } from "../components/landing/SiteHeader";
import { SiteFooter } from "../components/landing/SiteFooter";
import AirflowVelocity from "../components/stories/AirflowVelocity.astro";
import WorkflowExplorer from "../components/landing/WorkflowExplorer";
import { Ellipsis } from "lucide-react";
---
<BaseLayout title="Apache Magpie — Maintainer skills for your AI agent" description="Plug Magpie into your existing AI agent to help with security reports, pull requests, and issues.">
  <SiteHeader home revealAfterHero />
  <main id="main-content" class="redesign-home">
    <section class="hero container">
      <div class="hero-copy">
        <h1>Maintainer skills<br />for <span>your agent.</span></h1>
        <p>Magpie plugs into Claude Code, Codex, and other agent harnesses to help you handle security reports, pull requests, and issues.</p>
        <div class="hero-actions"><a class="button" href="/docs/quick-start">Get started</a><a class="text-link" href="#how-it-works">How it works</a></div>
      </div>
      <div class="integration-art" aria-label="Magpie connects your agent to ready-made software maintenance workflows">
        <div class="agent-shell">
          <div class="agent-options"><span><img src="/vendor-logos/claude.png" alt="" width="28" height="28" />Claude Code</span><span><img src="/vendor-logos/openai.png" alt="" width="28" height="28" />Codex</span><span class="other-agents"><Ellipsis size={28} strokeWidth={1.4} />Other agents…</span></div>
          <svg class="diagram-wires wires-in" viewBox="0 0 300 48" preserveAspectRatio="none" aria-hidden="true"><path d="M50 0V22H250V0M150 0V48" /></svg>
          <div class="magpie-plugin"><img src="/wordmark.svg" alt="Magpie" width="158" height="45" /><span>Maintainer skill families</span></div>
          <svg class="diagram-wires wires-out" viewBox="0 0 300 48" preserveAspectRatio="none" aria-hidden="true"><path d="M150 0V48M50 48V24H250V48" /></svg>
          <div class="skill-tree">
            <div class="skill-column"><a href="/docs/security/readme">Security response</a><a href="/docs/release-management/readme">Release management</a><a href="/docs/repo-health/readme">Repository health</a></div>
            <div class="skill-column"><a href="/docs/pr-management/readme">PR reviews</a><a href="/docs/issue-management/readme">Issue triage</a><a href="/docs/pairing/readme">Pair programming</a></div>
            <div class="skill-column"><a href="/docs/mentoring/readme">Contributor mentoring</a><a href="/docs/contributor-growth/readme">Contributor growth</a><a href="/docs/setup/readme">Agent setup</a></div>
          </div>
        </div>
      </div>
    </section>
    <section id="airflow" class="airflow-section"><div class="container">
      <div class="case-layout">
        <div class="case-quote"><h2>More capacity for Airflow</h2><blockquote>“Using Magpie helped us to do things that matter”</blockquote><div class="quote-person"><img src="/community-avatars/potiuk.png" alt="" width="44" height="44" loading="lazy" /><div><strong>Jarek Potiuk</strong><span>Apache Airflow PMC member</span></div></div><a class="light-link case-story" href="/stories/airflow">Read Jarek’s story</a></div>
        <div class="case-evidence"><AirflowVelocity /></div>
      </div>
    </div></section>
    <section id="how-it-works" class="section container" data-reveal>
      <div class="section-heading"><div><h2>From incoming work to a finished outcome</h2></div><p>Magpie teaches your agent the whole workflow: which tools to use, what to check, and when to ask you. Choose a job to see it in action.</p></div>
      <WorkflowExplorer client:load />
    </section>
    <section class="docs-invitation container" data-reveal><div><h2>Put Magpie to work</h2><p>Set up your agent, choose your workflows, and start with your project.</p></div><a class="button" href="/docs/quick-start">Open the documentation</a></section>
  </main>
  <SiteFooter />
</BaseLayout>
