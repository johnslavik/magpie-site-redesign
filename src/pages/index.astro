---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader } from "../components/landing/SiteHeader";
import { SiteFooter } from "../components/landing/SiteFooter";
import AirflowVelocity from "../components/stories/AirflowVelocity.astro";
import WorkflowExplorer from "../components/landing/WorkflowExplorer";
import { ArrowRight, ArrowDown } from "lucide-react";
import HeroWorkflows from "../components/landing/HeroWorkflows";
import BrandName from "../components/landing/BrandName";
import MoreWays from "../components/landing/MoreWays.astro";
---
<BaseLayout title="Apache Magpie | Software maintenance, automated" description="Ready-to-use agent workflows for code reviews, bug fixes, security, releases, repository upkeep, and contributor onboarding.">
  <SiteHeader home revealAfterHero />
  <main id="main-content" class="redesign-home">
    <section class="hero container">
      <div class="hero-copy">
        <img class="hero-wordmark" src="/wordmark.svg" alt="Magpie" width="200" height="57" />
        <h1>We’ve <span>automated software <br />maintenance</span> for you.</h1>
        <p class="hero-story">AI brought more contributions to open source and more work for maintainers. To keep up at Apache Airflow, we turned maintenance procedures into <strong>dozens of reusable skills</strong>. <BrandName /> brings those skills to your coding agent, ready for your own project.</p>
      </div>
      <a class="hero-read-cue" href="#workflow-examples" aria-label="Keep reading: see what Magpie does" hidden><ArrowDown size={22} strokeWidth={1.4} /></a>
    </section>
    <section id="workflow-examples" class="integration-section container" aria-labelledby="workflow-examples-title">
      <h2 id="workflow-examples-title" class="examples-heading">What can Magpie do for you?</h2>
      <div class="integration-art" aria-label="Magpie connects your agent to ready-made software maintenance workflows">
        <div class="agent-shell">
          <HeroWorkflows client:load />
          <p class="diagram-context">Works in</p>
          <div class="supported-agents" aria-label="Supported agent tools">
            <a href="/docs/quick-start" target="_blank" rel="noreferrer"><img src="/vendor-logos/claude.png" width="30" height="30" alt="" /><span>Claude Code</span></a><a href="/docs/adapters/codex" target="_blank" rel="noreferrer"><img src="/vendor-logos/openai.png" width="30" height="30" alt="" /><span>Codex</span></a><a href="/docs/adapters/cursor" target="_blank" rel="noreferrer"><img src="/vendor-logos/cursor.svg" width="30" height="30" alt="" /><span>Cursor</span></a>
            <a href="/docs/adapters/copilot" target="_blank" rel="noreferrer"><img src="/vendor-logos/copilot.svg" width="30" height="30" alt="" /><span>GitHub Copilot</span></a><a href="/docs/adapters/gemini" target="_blank" rel="noreferrer"><img src="/vendor-logos/gemini.ico" width="30" height="30" alt="" /><span>Gemini CLI</span></a><a href="/docs/adapters/opencode" target="_blank" rel="noreferrer"><img src="/vendor-logos/opencode.png" width="30" height="30" alt="" /><span>OpenCode</span></a>
          </div>
          <a class="more-adapters" href="/docs/adapters/readme" target="_blank" rel="noreferrer">And much more</a>
        </div>
      </div>
    </section>
    <span class="diagram-nav-trigger" data-nav-trigger aria-hidden="true"></span>
    <section id="how-it-works" class="section container security-story-section">
      <div class="security-intro"><h2>See how Magpie<br />helps scale security.</h2><p>Apache Airflow powers workflows at Airbnb, Adobe, and Spotify.<br />Follow an example report from investigation to disclosure.</p></div>
      <WorkflowExplorer client:load />
      <div class="security-summary">
        <span class="summary-eyebrow">From one incoming report</span>
        <h3>A tested fix. A released update.<br />Users who know what to do.</h3>
        <p><BrandName /> prepares the investigation, patch, and disclosure.<br />Your team reviews the evidence and makes the decisions.</p>
      </div>
    </section>
    <section id="airflow" class="airflow-section">
      <svg class="airflow-curve" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60C240 60 310 10 580 14S1010 88 1440 24V80H0Z" /></svg>
      <div class="container">
      <div class="case-layout">
        <div class="case-quote"><h2>More reports resolved.<br />More time to maintain.</h2><div class="case-example"><span>At</span><img class="airflow-brand" src="/vendor-logos/airflow.svg" alt="Apache Airflow" width="155" height="60" /></div><blockquote>“Using <BrandName /> helped us to do things that matter”</blockquote><div class="quote-person"><img src="/community-avatars/potiuk.png" alt="" width="44" height="44" loading="lazy" /><div><strong>Jarek Potiuk</strong><span>Apache Airflow PMC member</span></div></div><a class="light-link case-story" href="/stories/airflow" target="_blank" rel="noreferrer">Read the Airflow story and results</a></div>
        <div class="case-evidence"><AirflowVelocity /></div>
      </div>
    </div></section>
    <MoreWays />
    <section class="docs-invitation container" data-reveal><div><h2>Ready to change how<br />you maintain software?</h2></div><a class="button" href="/docs/quick-start" target="_blank" rel="noreferrer"><ArrowRight size={20} strokeWidth={1.7} aria-hidden="true" /><span>Get started now</span></a></section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const cue = document.querySelector<HTMLAnchorElement>('.hero-read-cue');
  if (cue) {
    let hasScrolled = window.scrollY > 4;
    const hideAfterScroll = () => {
      if (window.scrollY > 4) hasScrolled = true;
      if (hasScrolled) cue.hidden = true;
    };
    window.addEventListener('scroll', hideAfterScroll, { passive: true });
    const showCue = () => window.setTimeout(() => {
      cue.hidden = hasScrolled || window.scrollY > 4;
    }, 4000);
    if (document.readyState === 'complete') showCue();
    else window.addEventListener('load', showCue, { once: true });
  }
</script>
