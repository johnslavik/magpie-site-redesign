---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader } from "../components/landing/SiteHeader";
import { SiteFooter } from "../components/landing/SiteFooter";
import AirflowVelocity from "../components/stories/AirflowVelocity.astro";
import WorkflowExplorer from "../components/landing/WorkflowExplorer";
import { ArrowRight, ArrowDown, ShieldAlert, CircleCheck } from "lucide-react";
import HeroWorkflows from "../components/landing/HeroWorkflows";
import BrandName from "../components/landing/BrandName";
import SectionWave from "../components/landing/SectionWave.astro";
import MoreWays from "../components/landing/MoreWays.astro";
---
<BaseLayout title="Apache Magpie | Software maintenance, automated" description="Ready-to-use agent workflows for code reviews, bug fixes, security, releases, repository upkeep, and contributor onboarding.">
  <SiteHeader />
  <main id="main-content" class="redesign-home">
    <section class="hero container">
      <div class="hero-copy">
        <h1>We’ve <span>automated software <br />maintenance</span> for you.</h1>
        <p class="hero-story">We refined <BrandName /> over months of maintaining <strong>Apache Airflow</strong>, a project relied on around the world, and handling <strong>thousands of tickets</strong>. Now we’re sharing that hard-earned knowledge as <strong>dozens of open-source coding agent skills</strong>, free for your agent to use and your team to adapt.</p>
      </div>
      <a class="hero-read-cue" href="#workflow-examples" aria-label="Keep reading: see what Magpie does"><ArrowDown size={22} strokeWidth={1.4} /></a>
    </section>
    <section id="workflow-examples" class="integration-section container" aria-labelledby="workflow-examples-title">
      <h2 id="workflow-examples-title" class="examples-heading">What can Magpie do for you?</h2>
      <div class="integration-art" aria-label="Magpie connects your agent to ready-made software maintenance workflows">
        <div class="agent-shell">
          <HeroWorkflows client:load />
          <p class="diagram-context">Works in</p>
          <div class="supported-agents" aria-label="Supported agent tools">
            <a href="/start" target="_blank" rel="noreferrer"><img src="/vendor-logos/claude.png" width="30" height="30" alt="" /><span>Claude Code</span></a><a href="/docs/adapters/codex" target="_blank" rel="noreferrer"><img src="/vendor-logos/openai.png" width="30" height="30" alt="" /><span>Codex</span></a><a href="/docs/adapters/cursor" target="_blank" rel="noreferrer"><img src="/vendor-logos/cursor.svg" width="30" height="30" alt="" /><span>Cursor</span></a>
            <a href="/docs/adapters/copilot" target="_blank" rel="noreferrer"><img src="/vendor-logos/copilot.svg" width="30" height="30" alt="" /><span>GitHub Copilot</span></a><a href="/docs/adapters/gemini" target="_blank" rel="noreferrer"><img src="/vendor-logos/gemini.ico" width="30" height="30" alt="" /><span>Gemini CLI</span></a><a href="/docs/adapters/opencode" target="_blank" rel="noreferrer"><img src="/vendor-logos/opencode.png" width="30" height="30" alt="" /><span>OpenCode</span></a>
          </div>
          <a class="more-adapters" href="/docs/adapters/readme" target="_blank" rel="noreferrer">and much more</a>
        </div>
      </div>
    </section>
    <section id="airflow" class="airflow-section">
      <SectionWave reverse /><SectionWave bottom />
      <div class="container">
      <h2 class="case-heading">How Airflow uses Magpie to keep up with security reports</h2>
      <div class="case-layout">
        <div class="case-evidence"><AirflowVelocity /></div>
        <div class="case-quote"><img class="airflow-brand" src="/vendor-logos/airflow.svg" alt="Apache Airflow" width="155" height="60" /><blockquote>“Using <BrandName /> helped us to do things that matter”</blockquote><div class="quote-person"><img src="/community-avatars/potiuk.png" alt="" width="52" height="52" loading="lazy" /><div><strong>Jarek Potiuk</strong><span>Apache Airflow PMC member</span></div></div><a class="light-link case-story" href="/stories/airflow" target="_blank" rel="noreferrer">Read the Airflow story and results <ArrowRight size={18} aria-hidden="true" /></a></div>
      </div>
    </div></section>
    <section id="how-it-works" class="section container security-story-section">
      <WorkflowExplorer client:load />
      <div id="security-summary" class="security-summary" aria-label="What changed during the security workflow">
        <div class="security-summary-flow">
          <div class="summary-state"><h3>Without Magpie</h3><div class="summary-card summary-before"><ShieldAlert size={32} strokeWidth={1.5} aria-hidden="true" /><strong>You coordinate every step</strong><p>Gather the evidence, work out the next steps, and carry the context from investigation to disclosure.</p></div></div>
          <div class="summary-route"><ArrowRight size={32} strokeWidth={1.5} aria-hidden="true" /></div>
          <div class="summary-state"><h3>With Magpie</h3><div class="summary-card summary-after"><CircleCheck size={32} strokeWidth={1.5} aria-hidden="true" /><strong>Your agent prepares the work</strong><p>Magpie’s ready-made workflows guide your agent through the investigation, fix, and disclosure, keeping the evidence together.</p></div></div>
        </div>
        <p>You review the evidence and approve what happens next.</p>
      </div>
    </section>
    <MoreWays />
    <section class="invitation-band section-band band-blue"><SectionWave /><div class="docs-invitation container" data-reveal><img class="invitation-bird" src="/illustrations/magpie/magpie-looking-back.png" width="220" height="220" alt="" loading="lazy" /><div><h2>Ready to change how you maintain software?</h2></div><a class="button" href="/start" target="_blank" rel="noreferrer"><ArrowRight size={20} strokeWidth={1.7} aria-hidden="true" /><span>Get started now</span></a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
