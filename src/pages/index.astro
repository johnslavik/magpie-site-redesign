---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader } from "../components/landing/SiteHeader";
import { SiteFooter } from "../components/landing/SiteFooter";
import AirflowVelocity from "../components/stories/AirflowVelocity.astro";
import WorkflowExplorer from "../components/landing/WorkflowExplorer";
import { ArrowRight, ArrowDown } from "lucide-react";
import HeroWorkflows from "../components/landing/HeroWorkflows";
import BrandName from "../components/landing/BrandName";
import MoreWays from "../components/landing/MoreWays.astro";
---
<BaseLayout title="Apache Magpie | Software maintenance, automated" description="Ready-to-use agent workflows for code reviews, bug fixes, security, releases, repository upkeep, and contributor onboarding.">
  <SiteHeader home revealAfterHero />
  <main id="main-content" class="redesign-home">
    <section class="hero container">
      <div class="hero-copy">
        <img class="hero-wordmark" src="/wordmark.svg" alt="Magpie" width="200" height="57" />
        <h1>We’ve <span>automated software <br />maintenance</span> for you.</h1>
        <p>AI brought more contributions to open source. Maintainers needed a way to keep up. We turned the procedures behind that work into <strong>dozens of reusable skills</strong> your coding agent can follow. <BrandName /> grew out of that work at Apache Airflow. Now you can use those procedures in your own project.</p>
      </div>
      <a class="hero-read-cue" href="#workflow-examples" aria-label="Keep reading: see what Magpie does" hidden><ArrowDown size={22} strokeWidth={1.4} /></a>
    </section>
    <section id="workflow-examples" class="integration-section container" aria-label="How Magpie works with your tools">
      <div class="integration-art" aria-label="Magpie connects your agent to ready-made software maintenance workflows">
        <div class="agent-shell">
          <HeroWorkflows client:load />
          <p class="diagram-context">Works everywhere</p>
          <div class="supported-agents" aria-label="Supported agent tools">
            <a href="/docs/quick-start"><img src="/vendor-logos/claude.png" width="30" height="30" alt="" /><span>Claude Code</span></a><a href="/docs/adapters/codex"><img src="/vendor-logos/openai.png" width="30" height="30" alt="" /><span>Codex</span></a><a href="/docs/adapters/cursor"><img src="/vendor-logos/cursor.svg" width="30" height="30" alt="" /><span>Cursor</span></a>
            <a href="/docs/adapters/copilot"><img src="/vendor-logos/copilot.svg" width="30" height="30" alt="" /><span>GitHub Copilot</span></a><a href="/docs/adapters/gemini"><img src="/vendor-logos/gemini.ico" width="30" height="30" alt="" /><span>Gemini CLI</span></a><a href="/docs/adapters/opencode"><img src="/vendor-logos/opencode.png" width="30" height="30" alt="" /><span>OpenCode</span></a>
          </div>
        </div>
      </div>
    </section>
    <span class="diagram-nav-trigger" data-nav-trigger aria-hidden="true"></span>
    <section id="airflow" class="airflow-section">
      <svg class="airflow-curve" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60C240 60 310 10 580 14S1010 88 1440 24V80H0Z" /></svg>
      <div class="container">
      <div class="case-layout">
        <div class="case-quote"><h2>What could Magpie do<br />for your project?</h2><div class="case-example"><span>One example, from</span><img class="airflow-brand" src="/vendor-logos/airflow.svg" alt="Apache Airflow" width="155" height="60" /></div><blockquote>“Using <BrandName /> helped us to do things that matter”</blockquote><div class="quote-person"><img src="/community-avatars/potiuk.png" alt="" width="44" height="44" loading="lazy" /><div><strong>Jarek Potiuk</strong><span>Apache Airflow PMC member</span></div></div><a class="light-link case-story" href="/stories/airflow">Read the Airflow story and results</a></div>
        <div class="case-evidence"><AirflowVelocity /></div>
      </div>
    </div></section>
    <section id="how-it-works" class="section container" data-reveal>
      <div class="section-heading"><div><h2>See the whole workflow</h2></div><p>Each <BrandName /> skill is a procedure written for your agent: what to inspect, which tools to use, what evidence to keep, and when to ask you. See those procedures work together on a security report.</p></div>
      <WorkflowExplorer client:load />
    </section>
    <MoreWays />
    <section class="docs-invitation container" data-reveal><div><h2>Ready to change how<br />you maintain software?</h2></div><a class="button" href="/docs/quick-start"><ArrowRight size={20} strokeWidth={1.7} aria-hidden="true" /><span>Get started now</span></a></section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const cue = document.querySelector<HTMLAnchorElement>('.hero-read-cue');
  const hero = document.querySelector('.hero');
  if (cue && hero) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    const observer = new IntersectionObserver(([entry]) => {
      clearTimeout(timer);
      cue.hidden = true;
      if (entry.intersectionRatio >= .7) timer = setTimeout(() => { cue.hidden = false; }, 16000);
    }, { threshold: [.7] });
    observer.observe(hero);
  }
</script>
