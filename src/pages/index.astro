---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader } from "../components/landing/SiteHeader";
import { SiteFooter } from "../components/landing/SiteFooter";
import AirflowVelocity from "../components/stories/AirflowVelocity.astro";
import WorkflowExplorer from "../components/landing/WorkflowExplorer";
import { BookOpen } from "lucide-react";
import HeroWorkflows from "../components/landing/HeroWorkflows";
---
<BaseLayout title="Apache Magpie — Review code. Fix bugs. Ship releases." description="Ready-to-use agent workflows for code reviews, bug fixes, security, releases, repository upkeep, and contributor onboarding.">
  <SiteHeader home revealAfterHero />
  <main id="main-content" class="redesign-home">
    <section class="hero container">
      <div class="hero-copy">
        <img class="hero-wordmark" src="/wordmark.svg" alt="Magpie" width="200" height="57" />
        <h1>Review code. Fix bugs.<br /><span>Ship releases.</span></h1>
        <p>Magpie plugs into your AI agent to automate the work behind code reviews, security fixes, releases, and contributor onboarding. It carries each process from start to finish with you.</p>
        <div class="hero-actions"><a class="button" href="/docs/quick-start">Get started</a><a class="text-link" href="#workflow-examples">See how it works</a></div>
      </div>
      <span class="hero-nav-trigger" data-nav-trigger aria-hidden="true"></span>
    </section>
    <section id="workflow-examples" class="integration-section container" aria-label="How Magpie works with your tools">
      <div class="integration-art" aria-label="Magpie connects your agent to ready-made software maintenance workflows">
        <div class="agent-shell">
          <p class="diagram-context">In the tools you already use</p>
          <div class="supported-agents" aria-label="Supported agent tools">
            <a href="/docs/quick-start"><img src="/vendor-logos/claude.png" width="30" height="30" alt="" /><span>Claude Code</span></a><a href="/docs/adapters/codex"><img src="/vendor-logos/openai.png" width="30" height="30" alt="" /><span>Codex</span></a><a href="/docs/adapters/cursor"><img src="/vendor-logos/cursor.svg" width="30" height="30" alt="" /><span>Cursor</span></a>
            <a href="/docs/adapters/copilot"><img src="/vendor-logos/copilot.svg" width="30" height="30" alt="" /><span>GitHub Copilot</span></a><a href="/docs/adapters/gemini"><img src="/vendor-logos/gemini.ico" width="30" height="30" alt="" /><span>Gemini CLI</span></a><a href="/docs/adapters/opencode"><img src="/vendor-logos/opencode.png" width="30" height="30" alt="" /><span>OpenCode</span></a>
          </div>
          <svg class="diagram-wires wires-in" viewBox="0 0 300 48" preserveAspectRatio="none" aria-hidden="true"><path class="wires-six" d="M25 0V22H275V0M75 0V22M125 0V22M175 0V22M225 0V22M150 22V48" /><path class="wires-three" d="M50 0V22H250V0M150 0V48" /></svg>
          <div class="magpie-plugin"><img src="/wordmark.svg" alt="Magpie" width="158" height="45" /><span>Runs the entire process with you</span></div>
          <div class="workflow-connector" aria-hidden="true"></div>
          <HeroWorkflows client:load />
        </div>
      </div>
    </section>
    <section id="airflow" class="airflow-section">
      <svg class="airflow-curve" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60C240 60 310 10 580 14S1010 88 1440 24V80H0Z" /></svg>
      <div class="container">
      <div class="case-layout">
        <div class="case-quote"><h2>More capacity for Airflow</h2><blockquote>“Using Magpie helped us to do things that matter”</blockquote><div class="quote-person"><img src="/community-avatars/potiuk.png" alt="" width="44" height="44" loading="lazy" /><div><strong>Jarek Potiuk</strong><span>Apache Airflow PMC member</span></div></div><a class="light-link case-story" href="/stories/airflow">Read Jarek’s story</a></div>
        <div class="case-evidence"><AirflowVelocity /></div>
      </div>
    </div></section>
    <section id="how-it-works" class="section container" data-reveal>
      <div class="section-heading"><div><h2>See the whole workflow</h2></div><p>From a private vulnerability report to a released fix and a published CVE. From a bug report to a tested PR. Magpie connects the steps, tools, and handoffs that usually fall on you.</p></div>
      <WorkflowExplorer client:load />
    </section>
    <section class="docs-invitation container" data-reveal><div><h2>Put Magpie to work</h2><p>Set up your agent, choose your workflows, and start with your project.</p></div><a class="button" href="/docs/quick-start"><BookOpen size={20} strokeWidth={1.7} aria-hidden="true" /><span>Open the documentation</span></a></section>
  </main>
  <SiteFooter />
</BaseLayout>
