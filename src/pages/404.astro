---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SiteHeader } from '../components/landing/SiteHeader';
import { SiteFooter } from '../components/landing/SiteFooter';
---
<BaseLayout title="Page not found | Apache Magpie">
  <SiteHeader />
  <main id="main-content" class="container not-found"><div><h1>We couldn’t find that page</h1><p>The page may have moved. Let’s get you back to a useful place.</p><a class="button" href="/docs">Browse the documentation </a><a class="text-link" href="/">Back to Magpie </a></div><img src="/illustrations/magpie/magpie-flying.png" alt="A magpie taking flight" width="300" height="300" /></main>
  <SiteFooter />
</BaseLayout>
<style>.not-found{min-height:60vh;padding-block:90px;display:flex;align-items:center;justify-content:space-between;gap:40px}.not-found h1{font-size:clamp(38px,5vw,68px);font-weight:470;letter-spacing:-.05em;margin:15px 0}.not-found p{color:var(--muted);font-size:15px;margin-bottom:30px}.not-found .text-link{display:flex;margin-top:20px}.not-found img{max-width:30%;height:auto}@media(max-width:600px){.not-found{padding-block:55px;display:block}.not-found img{max-width:50%;margin:25px 0 0 auto}}</style>
