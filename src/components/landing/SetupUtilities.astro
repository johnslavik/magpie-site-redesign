---
import { ArrowRight, ShieldCheck, Bot, FolderCode, LockKeyhole, KeyRound, UserRound, Folder, Globe } from "lucide-react";
import MagpieCard from "./MagpieCard";
---
<section class="setup-utilities container isolation-comparison" aria-labelledby="setup-utilities-title">
  <div class="setup-explanation">
    <h2 id="setup-utilities-title">Give your agent a workspace, not your whole machine.</h2>
    <p>Work on untrusted software locally. Magpie installs and verifies layered protection, without a separate VM on macOS or Linux.</p>
  </div>
  <div class="isolation-sides">
    <div class="isolation-side isolation-open">
      <h3>In YOLO mode</h3>
      <p>Protections off. Your agent can reach what your session can.</p>
      <div class="open-agent"><Bot size={40} strokeWidth={1.5} aria-hidden="true" /><span>Your agent</span></div>
      <div class="open-access" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="exposed-resources">
        <div><Folder size={30} aria-hidden="true" /><span>Personal files</span></div>
        <div><KeyRound size={30} aria-hidden="true" /><span>Credentials</span></div>
        <div><Globe size={30} aria-hidden="true" /><span>Network</span></div>
      </div>
      <p class="isolation-consequence">One bad command or malicious instruction can reach beyond the project.</p>
    </div>
    <MagpieCard className="isolation-side isolation-protected">
      <p>Access scoped. Sensitive actions gated.</p>
      <div class="protection-stack">
        <div class="protection-layer"><KeyRound size={20} aria-hidden="true" /><span>Strips credentials from the environment</span></div>
        <div class="protection-layer"><ShieldCheck size={20} aria-hidden="true" /><span>Sandboxes file and network access</span></div>
        <div class="protection-layer"><LockKeyhole size={20} aria-hidden="true" /><span>Restricts agent tools</span></div>
        <div class="protection-layer"><UserRound size={20} aria-hidden="true" /><span>Requires approval for external writes</span></div>
        <div class="protected-workspace"><span class="sandbox-label"><ShieldCheck size={20} aria-hidden="true" />Your allowed workspace</span><div class="sandbox-contents"><div><Bot size={32} aria-hidden="true" /><span>Your agent</span></div><ArrowRight size={24} aria-hidden="true" /><div><FolderCode size={32} aria-hidden="true" /><span>Project files</span></div></div>
      </div>
    </div>
  </MagpieCard>
  </div>
  <div class="isolation-footer"><p class="isolation-limits">Protections vary by agent. Allowed project files remain accessible; sandboxing reduces risk rather than making arbitrary code safe.</p><a class="button" href="/docs/setup/secure-agent-setup" target="_blank" rel="noreferrer">Set up agent isolation <ArrowRight size={20} aria-hidden="true" /></a></div>
</section>
