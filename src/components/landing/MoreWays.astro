---
import SectionWave from "./SectionWave.astro";
import SetupUtilities from "./SetupUtilities.astro";
import { SoftwareLifecycle, ProjectRules, SkillComparison } from "./ProjectExamples";
---
<section class="choose-work section-band band-blue" aria-labelledby="choose-work-title">
  <SectionWave />
  <SectionWave bottom reverse />
  <div class="container">
  <div class="lifecycle-heading"><h2 id="choose-work-title">We’ve prepared workflows for the rest of your project, too.</h2></div>
  <SoftwareLifecycle client:load />
  </div>
</section>
<SetupUtilities />
<section class="project-fit section-band band-mint" aria-labelledby="project-fit-title">
  <SectionWave reverse />
  <SectionWave bottom />
  <div class="container">
    <div class="lifecycle-heading"><h2 id="project-fit-title">Make the procedures fit the way your team works.</h2></div>
    <ProjectRules />
  </div>
</section>
<section class="learn-skills container" aria-labelledby="learn-skills-title">
  <div class="lifecycle-heading"><h2 id="learn-skills-title">We even automated the automation.</h2></div>
  <SkillComparison />
  <div class="learning-links"><a class="text-link" href="/docs/education/your-first-skill" target="_blank" rel="noreferrer">Build your first skill with Magpie</a></div>
</section>
