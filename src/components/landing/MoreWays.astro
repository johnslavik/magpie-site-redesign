---
import { ArrowRight } from "lucide-react";
import ImprovementLoop from "./ImprovementLoop.astro";
import SectionWave from "./SectionWave.astro";
import SetupUtilities from "./SetupUtilities.astro";
import { SoftwareLifecycle, ProjectRules, SkillComparison } from "./ProjectExamples";
---
<section class="choose-work section-band band-blue" aria-labelledby="choose-work-title">
  <SectionWave />
  <SectionWave bottom reverse />
  <div class="container">

  <SoftwareLifecycle client:load />
  </div>
</section>
<SetupUtilities />
<section class="project-fit section-band band-mint" aria-labelledby="project-fit-title">
  <SectionWave reverse />
  <SectionWave bottom />
  <div class="container">
    <div class="lifecycle-heading"><h2 id="project-fit-title">Make it work for your project.</h2></div>
    <ProjectRules />
  </div>
</section>
<section class="learn-skills container" aria-labelledby="learn-skills-title">
  <div class="lifecycle-heading"><h2 id="learn-skills-title">We automated the automation.</h2></div>
  <SkillComparison />
  <ImprovementLoop authoring />
  <div class="learning-links"><a class="button skill-cta" href="/docs/education/your-first-skill" target="_blank" rel="noreferrer"><span>Build your first skill with Magpie</span><ArrowRight size={22} aria-hidden="true" /></a></div>
</section>
