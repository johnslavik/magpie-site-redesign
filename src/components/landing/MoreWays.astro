---
import { SoftwareLifecycle, ProjectRules, SkillComparison } from "./ProjectExamples";
---
<section class="choose-work container" aria-labelledby="choose-work-title">
  <div class="lifecycle-heading"><h2 id="choose-work-title">Automation for the whole<br />software lifecycle.</h2><p>From the first issue to the next release, and the people who keep it going.</p></div>
  <SoftwareLifecycle client:load />
</section>
<section class="project-fit" aria-labelledby="project-fit-title">
  <div class="container">
    <div class="lifecycle-heading"><h2 id="project-fit-title">Magpie works with<br />your project.</h2></div>
    <ProjectRules client:load />
    <a class="configure-link" href="/docs/setup/agentic-overrides" target="_blank" rel="noreferrer">Configure your project</a>
  </div>
</section>
<section class="learn-skills container" aria-labelledby="learn-skills-title">
  <div class="lifecycle-heading"><h2 id="learn-skills-title">We even automated<br />the automation.</h2></div>
  <SkillComparison />
  <div class="learning-links"><a class="text-link" href="/docs/education/your-first-skill" target="_blank" rel="noreferrer">Build your first skill with Magpie</a><a href="/docs/education/eval-driven-development" target="_blank" rel="noreferrer">How to test the results</a></div>
</section>
