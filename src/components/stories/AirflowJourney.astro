---
import { MagpieToolkit } from "../landing/MagpieCard";
import data from '../../data/airflow.json';
const monthly = data.series.monthly;
const opened = monthly.charts.c_open_vs_untriaged.find(s => s.label === 'opened in month')!.values;
const queue = monthly.charts.c_open_vs_untriaged.find(s => s.label === 'untriaged at month-end')!.values;
const cumulative = monthly.charts.c_cum.find(s => s.label === 'cumulative closed')!.values;
const periods = [
  { from:'2025-01', to:'2025-12', date:'2025', title:'A smaller stream of reports', text:'Before the surge in AI-generated contributions, fewer reports entered the tracker.', queueText:'Awaiting triage in December', end:'2025-12' },
  { from:'2026-01', to:'2026-03', date:'January to March 2026', title:'Reports outpace the team', text:'More reports arrive, and more are closed. But incoming work outpaces the team’s capacity.', queueText:'Awaiting triage in March', end:'2026-03' },
  { from:'2026-04', to:'2026-08', date:'April to August 2026', title:'More reports, far more work completed', text:'With Magpie in use, monthly closures rise. The triage queue shrinks, then grows again as reports keep arriving.', queueText:'Awaiting triage: March → June → August', end:'2026-08' },
];
const phases = periods.map(p => {
  const indices = monthly.buckets.flatMap((m,i) => m >= p.from && m <= p.to ? [i] : []);
  const mean = (values:number[]) => indices.reduce((sum,i) => sum + values[i],0) / indices.length;
  const closed = cumulative.map((v,i) => v - (cumulative[i-1] ?? 0));
  return {...p, incoming:mean(opened), closed:mean(closed), queue:queue[monthly.buckets.indexOf(p.end)]};
});
const ratio = (phases[2].closed / phases[1].closed).toFixed(1);
---
<div class="airflow-journey">
  <div class="journey-key"><span><i class="intake-key"></i>New tracked reports</span><span><i class="closed-key"></i>Tracked reports closed</span><small>Reports per month</small></div>
  {phases.map((phase,i) => <article class:list={["journey-stage", {"journey-after":i === 2}]}>
    {i === 2 && <div class="journey-introduction"><MagpieToolkit /><div><strong>Magpie introduced</strong><span>April 2026</span></div></div>}
    <div class="journey-chapter"><span class="journey-date">{phase.date}</span><h3>{phase.title}</h3></div>
    <div class="journey-visual">
      <div class="journey-bars" role="img" aria-label={`${phase.date}: ${phase.incoming.toFixed(1)} new tracked reports and ${phase.closed.toFixed(1)} tracked reports closed per month.`}>
        <div class="journey-bar-row"><span>New reports</span><div class="journey-bar-track"><div class="journey-bar intake-bar" style={`--bar-width:${phase.incoming/35*100}%`}></div></div><strong>{phase.incoming.toFixed(1)}</strong></div>
        <div class="journey-bar-row"><span>Closed</span><div class="journey-bar-track"><div class="journey-bar closed-bar" style={`--bar-width:${phase.closed/35*100}%`}></div></div><strong>{phase.closed.toFixed(1)}</strong></div>
      </div>
      <div class="journey-queue"><span>{phase.queueText}</span>{i === 2 ? <div class="queue-sequence"><strong>{phases[1].queue}</strong><span aria-hidden="true">→</span><strong class="queue-low">{queue[monthly.buckets.indexOf("2026-06")]}</strong><span aria-hidden="true">→</span><strong>{phase.queue}</strong></div> : <div class="queue-count"><div class="queue-dots" aria-hidden="true">{Array.from({length:phase.queue},()=><i></i>)}</div><strong>{phase.queue}</strong></div>}</div>
    </div>
  </article>)}
  <div class="journey-result"><strong>{ratio}×</strong><div><h3>As many tracked reports closed per month</h3><p>{phases[1].closed.toFixed(1)} before → {phases[2].closed.toFixed(1)} with Magpie</p><small>Jan–Mar compared with Apr–Aug 2026. Closed includes outcomes other than a released fix.</small></div></div>
  <details class="journey-source"><summary>Data and methodology</summary><p>Airflow tracker data, complete months through August 2026. Reports screened out before tracking are excluded. These observations do not isolate Magpie’s effect. <a href="/stories/airflow#data" target="_blank" rel="noreferrer">Explore the data ↗</a></p></details>
</div>
<script>
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => { if(entry.isIntersecting) { entry.target.classList.add('journey-seen'); observer.unobserve(entry.target); } });
  }, {threshold:0.25});
  document.querySelectorAll('.journey-stage').forEach(stage => observer.observe(stage));
</script>
<style>
.airflow-journey{--intake:#9b542d;--closed:#075bb7;--track:#172b2010;--rule:#34583633;--queue:#9b542d;color:var(--ink);max-width:980px;margin:auto}
:global(html[data-theme=dark]) .airflow-journey{--intake:#efb589;--closed:#91c4ff;--track:#ffffff09;--rule:#b5cce333;--queue:#efb589}
.journey-key{display:flex;align-items:center;justify-content:flex-end;gap:24px;flex-wrap:wrap;font-size:14px;margin:0 0 32px}.journey-key>span{display:flex;align-items:center;gap:8px}.journey-key i{width:10px;height:10px;border-radius:3px}.intake-key{background:var(--intake)}.closed-key{background:var(--closed)}.journey-key small{width:100%;text-align:right;color:var(--muted)}
.journey-stage{display:grid;grid-template-columns:1fr 1.15fr;gap:70px;align-items:center;padding:72px 0;border-top:1px solid var(--rule)}.journey-date{display:flex;align-items:center;gap:16px;font-size:13px;color:var(--muted)}.journey-chapter h3{font-size:clamp(25px,3vw,34px);line-height:1.2;letter-spacing:-.035em;font-weight:500;margin:22px 0 16px}.journey-chapter p{font-size:16px;line-height:1.7;color:var(--muted);margin:0;max-width:360px}.journey-bar-row{display:grid;grid-template-columns:88px minmax(0,1fr) 40px;gap:12px;align-items:center;margin:18px 0;font-size:13px}.journey-bar-row strong{font-size:18px;font-weight:500;font-variant-numeric:tabular-nums}.journey-bar-track{height:28px;background:var(--track);border-radius:4px;overflow:hidden}.journey-bar{width:var(--bar-width);height:100%;border-radius:4px}.intake-bar{background:var(--intake)}.closed-bar{background:var(--closed)}.journey-seen .journey-bar{animation:bar-enter .85s ease-out both;transform-origin:left}.journey-seen .closed-bar{animation-delay:.12s}@keyframes bar-enter{from{transform:scaleX(0)}to{transform:scaleX(1)}}.journey-queue{margin-top:38px;padding-top:22px;border-top:1px solid var(--rule);display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:13px;color:var(--muted)}.queue-count{display:flex;align-items:center;gap:16px}.queue-count strong,.queue-sequence strong{font-size:22px;font-weight:500;color:var(--queue);font-variant-numeric:tabular-nums}.queue-dots{display:grid;grid-template-columns:repeat(8,5px);gap:4px}.queue-dots i{width:5px;height:5px;background:var(--queue);border-radius:1px}.queue-sequence{display:flex;gap:13px;align-items:center;white-space:nowrap}.queue-sequence .queue-low{color:var(--closed)}.journey-result{border-top:1px solid var(--rule);padding-top:64px;margin-top:16px;display:flex;gap:36px;align-items:center}.journey-result>strong{color:var(--closed);font-size:clamp(70px,9vw,110px);font-weight:500;letter-spacing:-.07em;line-height:1}.journey-result h3{font-size:23px;letter-spacing:-.025em;font-weight:500;margin:0 0 12px}.journey-result p{margin:0 0 10px;font-size:19px}.journey-result small,.journey-source{font-size:12px;line-height:1.7;color:var(--muted)}.journey-source{max-width:720px;margin:30px 0 0}.journey-source a{color:inherit;text-underline-offset:3px}
.journey-introduction{grid-column:1 / -1;display:flex;align-items:center;justify-content:center;gap:16px;padding:28px;border-block:1px solid var(--closed);margin-bottom:8px;color:var(--closed)}.journey-introduction strong{display:block;font-size:23px;font-weight:500;letter-spacing:-.025em}.journey-introduction span{display:block;margin-top:5px;font-size:14px;color:var(--muted)}.journey-after{border-top:0;background:linear-gradient(180deg,transparent,var(--track));border-radius:0 0 16px 16px}.journey-source summary{cursor:pointer;text-underline-offset:4px;text-decoration:underline}.journey-after .journey-bar-track{background:var(--rule)}
@media(min-width:701px){
.airflow-journey{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.journey-key{grid-column:1 / -1;justify-content:center;margin:0;gap:10px 22px}.journey-key small{width:auto;text-align:center}
.journey-stage{position:relative;display:flex;flex-direction:column;align-items:stretch;gap:22px;padding:24px 18px;margin-top:50px;border:1px solid var(--rule);border-radius:12px}
.journey-chapter h3{font-size:23px;min-height:56px;margin:12px 0 0}.journey-date{font-size:12px;min-height:18px}.journey-visual{margin-top:auto}.journey-bar-row{grid-template-columns:60px minmax(0,1fr) 34px;font-size:11px;gap:7px}.journey-bar-row strong{font-size:16px}.journey-bar-track{height:22px}.journey-queue{margin-top:20px;padding-top:18px;min-height:55px;align-items:flex-start;flex-direction:column;gap:12px}.queue-count{align-self:flex-end}.queue-sequence{align-self:flex-end}.journey-introduction{position:absolute;left:0;right:0;top:-60px;height:48px;margin:0;padding:0;border:0;gap:10px}.journey-introduction strong{font-size:17px}.journey-introduction span{font-size:12px;margin:0}.journey-introduction :global(.magpie-toolkit){width:40px;height:35px}.journey-after{border:1px solid var(--closed);background:var(--track)}
.journey-result{grid-column:1 / -1;justify-content:center;gap:28px;margin:0;padding-top:24px;border:0}.journey-result>strong{font-size:72px}.journey-result h3{font-size:20px;margin-bottom:8px}.journey-result p{font-size:17px;margin-bottom:5px}.journey-source{grid-column:1 / -1;text-align:center;max-width:none;margin:0}
}
@media(max-width:700px){.journey-key{justify-content:flex-start;gap:12px 20px}.journey-key small{text-align:left}.journey-stage{grid-template-columns:1fr;gap:30px;padding:48px 0}.journey-chapter p{max-width:none}.journey-queue{margin-top:28px}.journey-result{align-items:flex-start;flex-direction:column;gap:25px;padding-top:44px}.journey-bar-row{grid-template-columns:80px minmax(0,1fr) 38px;gap:8px}}
@media(prefers-reduced-motion:reduce){.journey-seen .journey-bar{animation:none}}
</style>
