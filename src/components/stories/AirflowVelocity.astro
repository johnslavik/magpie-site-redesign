---
import data from '../../data/airflow.json';
const monthly = data.series.monthly;
const cumulative = monthly.charts.c_cum.find(series => series.label === 'cumulative closed')!.values;
// First differences give completed reports per month, not cumulative backlog.
// September is incomplete in the source snapshot, so the chart ends in August.
const points = monthly.buckets.flatMap((month, i) => month >= '2026-01' && month <= '2026-08'
  ? [{ month, count: cumulative[i] - cumulative[i - 1] }] : []);
const x = (i: number) => 35 + i * 54;
const y = (count: number) => 194 - count / 50 * 156;
const line = points.map((point, i) => `${i ? 'L' : 'M'}${x(i)},${y(point.count)}`).join(' ');
const area = `${line} L${x(points.length - 1)},194 L35,194 Z`;
const before = points.slice(0, 3).reduce((sum, p) => sum + p.count, 0) / 3;
const after = points.slice(3).reduce((sum, p) => sum + p.count, 0) / 5;
const ratio = (after / before).toFixed(1);
const adoptionX = (x(2) + x(3)) / 2;
---
<figure class="velocity-chart">
  <figcaption><strong>{ratio}×</strong><span>monthly security-report closures<br />after Magpie adoption</span></figcaption>
  <svg viewBox="0 0 448 238" role="img" aria-labelledby="velocity-title velocity-description">
    <title id="velocity-title">Security reports closed per month at Apache Airflow</title>
    <desc id="velocity-description">January to August 2026: {points.map(p => p.count).join(', ')} reports closed. Magpie adoption is marked at April. Monthly averages: {before.toFixed(1)} before, {after} after. September is excluded because it is incomplete.</desc>
    {[0,20,40].map(value => <g><line class="velocity-grid" x1="35" x2="422" y1={y(value)} y2={y(value)} /><text class="velocity-axis" x="22" y={y(value)+4} text-anchor="end">{value}</text></g>)}
    <path class="velocity-area" d={area} />
    <line class="velocity-adoption" x1={adoptionX} x2={adoptionX} y1="36" y2="194" />
    <text class="velocity-label" x={adoptionX+9} y="23">Magpie introduced</text>
    <path class="velocity-line" d={line} />
    <text class="velocity-value" x={x(7)} y={y(points[7].count)-12} text-anchor="middle">44</text>
    {points.map((p, i) => <text class="velocity-axis" x={x(i)} y="218" text-anchor="middle">{new Date(`${p.month}-01T12:00:00Z`).toLocaleString('en', { month: 'short', timeZone: 'UTC' })}</text>)}
  </svg>
  <div class="velocity-caption"><span>Jan–Mar vs Apr–Aug 2026</span><a href="/stories/airflow#data">See the data</a></div>
</figure>
