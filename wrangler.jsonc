{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magpie-site-redesign",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
